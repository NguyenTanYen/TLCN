# Công cụ một lần: nạp dữ liệu demo THẬT lên Moodle (khóa học, 40 SV, Quiz, bài làm, Offline Quiz) – xem HUONG_DAN_DEPLOY_ORACLE.md mục 6
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends php-cli php-mysql php-xml php-mbstring php-intl php-gd php-curl php-zip php-soap \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt pymupdf
COPY database /app/database
COPY backend /app/backend
COPY tools /app/tools
WORKDIR /app/backend
CMD ["python", "../tools/moodle_e2e/run_real_moodle_e2e.py", "/var/www/html"]
