# Cấu hình kết nối – 0_CAU_HINH.bat tự chép tệp này thành cau_hinh.env ở lần chạy đầu; sửa nếu máy khác mật khẩu / cổng / tên CSDL.
# Bước 3 (3_CAI_GIAO_DIEN_MOODLE.bat) tự ghi MOODLE_URL, MOODLE_WS_TOKEN, MOODLE_SSO_SECRET, DATABASE_ADMIN_URL
# và chuyển DATABASE_URL sang tài khoản chỉ đọc Moodle (clo_app).
DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/assessment_db?charset=utf8mb4
MOODLE_DB_NAME=moodle_db
MOODLE_PREFIX=mdl_
# Để trống: hệ thống tự sinh khóa JWT ngẫu nhiên và lưu ở backend/.jwt_secret
JWT_SECRET=
# DEMO_MODE=true   # hiện nút điền nhanh tài khoản minh họa ở trang đăng nhập (xóa khi triển khai thật)
# RAG_SYNC_MINUTES=30   # chu kỳ tự đồng bộ + nạp học liệu (slide, tài liệu) từ khóa học Moodle của lớp; 0 = tắt
# Cổng ngữ nghĩa của gợi ý học liệu (cần requirements-semantic.txt): câu hỏi không liên quan tài liệu thì không gợi ý
# RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   # để trống = tắt, chỉ dùng BM25
# RAG_MIN_SIMILARITY=0.55
