digraph A { rankdir=TB; graph [fontname="DejaVu Sans", dpi=170, nodesep=0.7, ranksep=0.85, newrank=true, splines=ortho, forcelabels=true];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, fillcolor="#EAF2FB", color="#445566"];
edge [fontname="DejaVu Sans", fontsize=9, color="#445566"];
sv [label="Sinh viên", shape=ellipse, fillcolor="#FDF3E1"]; gv [label="Giảng viên", shape=ellipse, fillcolor="#FDF3E1"]; bm [label="Bộ môn /\nQuản trị", shape=ellipse, fillcolor="#FDF3E1"];
subgraph cluster_lms { label="Moodle 4.5 LMS (PHP)"; style="rounded,filled"; fillcolor="#EEF7F7"; color="#669999";
  theme [label="Theme UTE LMS\n(giao diện học tập)"];
  quiz [label="Quiz · Question bank\nxáo trộn phương án, tự chấm"];
  plugin [label="Plugin local_clo\nnút \"Phân tích CĐR\" (SSO)\nWeb Service create_quiz / push_results\ntrang \"Kết quả phân tích CĐR\"", fillcolor="#FDE9E7"]; }
subgraph cluster_sys { label="Hệ thống phân tích CĐR (FastAPI + React) – dành cho GV / Bộ môn"; style="rounded,filled"; fillcolor="#F4FBF4"; color="#88AA88";
  spa [label="React 19 SPA\nVite · Chart.js"];
  routers [label="Routers REST\nauth · catalog · courses · questions · question_io\nexams · sync · lms · analytics · insights · reports"];
  svc [label="Services\nxml_export · paper · reports_excel\nmoodle (cầu nối) · lms (Web Service)"];
  ae [label="Analysis Engine (Pandas)\np, DI · CLO → PI → PLO · lộ trình", fillcolor="#FFF4D6"]; }
subgraph cluster_db { label="MySQL / MariaDB (cùng một máy chủ)"; style="rounded,filled"; fillcolor="#FFFBF2"; color="#AA9966";
  mdb [label="moodle_db\nmdl_* · mdl_local_clo_*", shape=cylinder, fillcolor="#E6F4F4"];
  bridge [label="Cầu nối (chỉ đọc)\nv_mdl_* · sp_sync_exam", shape=component, fillcolor="#FDE9E7"];
  adb [label="assessment_db\n39 bảng · 4 view", shape=cylinder, fillcolor="#FFF7D6"]; }
{rank=same; sv; gv; bm;}
{rank=same; theme; spa;}
{rank=same; quiz; plugin; routers;}
{rank=same; svc; ae;}
{rank=same; mdb; bridge; adb;}
sv -> theme [xlabel="làm bài,\nxem kết quả"]; gv -> theme; gv -> spa [style=dashed, xlabel="đăng nhập\ntrực tiếp"]; bm -> spa;
theme -> quiz; theme -> plugin;
plugin -> routers [xlabel="① vé SSO\n(JWT HS256, 120 s)", color="#C0504D", fontcolor="#C0504D"];
spa -> routers [xlabel="HTTPS/JSON · JWT"];
routers -> svc; routers -> ae;
svc -> plugin [xlabel="② Web Service REST\ntạo Quiz · gửi kết quả", color="#C0504D", fontcolor="#C0504D", constraint=false];
svc -> bridge [xlabel="③ CALL\nsp_sync_exam"]; ae -> adb;
bridge -> mdb [xlabel="SELECT", style=dashed, minlen=2]; bridge -> adb [xlabel="ghi", minlen=2];
quiz -> mdb; plugin -> mdb;
}
