digraph G { rankdir=LR; graph [fontname="DejaVu Sans", splines=ortho, nodesep=0.6, ranksep=0.9 ];
node [shape=none, margin=0, fontname="DejaVu Sans", fontsize=10]; edge [color="#334155", penwidth=1.2, dir=none];
"question_moodle_links" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E9F0DD" colspan="2"><b>question_moodle_links</b></td></tr><tr><td align="left" port="question_id"><u>question_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="moodle_course_id"><u>moodle_course_id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">bigint(20) NN</font></td></tr><tr><td align="left" port="moodle_question_id">moodle_question_id</td><td align="left"><font color="#555555">bigint(20) NN</font></td></tr><tr><td align="left" port="sync_hash">sync_hash</td><td align="left"><font color="#555555">char(64) NN</font></td></tr><tr><td align="left" port="synced_at">synced_at</td><td align="left"><font color="#555555">datetime NN</font></td></tr></table>>];
"scan_sheets" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E9F0DD" colspan="2"><b>scan_sheets</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">bigint(20) NN</font></td></tr><tr><td align="left" port="exam_id">exam_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="source_name">source_name</td><td align="left"><font color="#555555">varchar(255)</font></td></tr><tr><td align="left" port="student_code">student_code</td><td align="left"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="version_code">version_code</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="answers">answers</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="score">score</td><td align="left"><font color="#555555">decimal(7,2)</font></td></tr><tr><td align="left" port="raw_max">raw_max</td><td align="left"><font color="#555555">decimal(7,2)</font></td></tr><tr><td align="left" port="confidence">confidence</td><td align="left"><font color="#555555">decimal(4,2)</font></td></tr><tr><td align="left" port="issues">issues</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left" port="image">image</td><td align="left"><font color="#555555">mediumtext</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(12) NN</font></td></tr><tr><td align="left" port="attempt_id">attempt_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11)</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">datetime NN</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#555555">datetime NN</font></td></tr></table>>];
"improvement_actions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E9F0DD" colspan="2"><b>improvement_actions</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="class_section_id">class_section_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="clo_id">clo_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11)</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="owner">owner</td><td align="left"><font color="#555555">varchar(150)</font></td></tr><tr><td align="left" port="due_date">due_date</td><td align="left"><font color="#555555">date</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="result">result</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">datetime NN</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#555555">datetime NN</font></td></tr></table>>];
