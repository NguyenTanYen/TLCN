digraph G { rankdir=LR; graph [fontname="DejaVu Sans", splines=ortho, nodesep=0.6, ranksep=0.9 ];
node [shape=none, margin=0, fontname="DejaVu Sans", fontsize=10]; edge [color="#334155", penwidth=1.2, dir=none];
"users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDF3E1" colspan="2"><b>users</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="username">username</td><td align="left"><font color="#555555">varchar(50) NN</font></td></tr><tr><td align="left" port="password_hash">password_hash</td><td align="left"><font color="#555555">varchar(255) NN</font></td></tr><tr><td align="left" port="full_name">full_name</td><td align="left"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#555555">varchar(150)</font></td></tr><tr><td align="left" port="role">role</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="is_active">is_active</td><td align="left"><font color="#555555">tinyint(1) NN</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">timestamp NN</font></td></tr></table>>];
"lecturers" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDF3E1" colspan="2"><b>lecturers</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="user_id">user_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11)</font></td></tr><tr><td align="left" port="lecturer_code">lecturer_code</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="full_name">full_name</td><td align="left"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="department">department</td><td align="left"><font color="#555555">varchar(150)</font></td></tr></table>>];
"students" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDF3E1" colspan="2"><b>students</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="user_id">user_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11)</font></td></tr><tr><td align="left" port="student_code">student_code</td><td align="left"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="full_name">full_name</td><td align="left"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="class_name">class_name</td><td align="left"><font color="#555555">varchar(50)</font></td></tr><tr><td align="left" port="moodle_user_id">moodle_user_id</td><td align="left"><font color="#555555">bigint(20)</font></td></tr></table>>];
"semesters" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDF3E1" colspan="2"><b>semesters</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="academic_year">academic_year</td><td align="left"><font color="#555555">varchar(9) NN</font></td></tr><tr><td align="left" port="term">term</td><td align="left"><font color="#555555">tinyint(4) NN</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">varchar(50) NN</font></td></tr><tr><td align="left" port="start_date">start_date</td><td align="left"><font color="#555555">date NN</font></td></tr><tr><td align="left" port="end_date">end_date</td><td align="left"><font color="#555555">date NN</font></td></tr></table>>];
"users" -> "students" [id="fk__users__students__user_id"];
"users" -> "lecturers" [id="fk__users__lecturers__user_id"];
}