digraph G { rankdir=LR; graph [fontname="DejaVu Sans", splines=ortho, nodesep=0.6, ranksep=0.9 ];
node [shape=none, margin=0, fontname="DejaVu Sans", fontsize=10]; edge [color="#334155", penwidth=1.2, dir=none];
"courses" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EAF6EA" colspan="2"><b>courses</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="course_code">course_code</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="course_name">course_name</td><td align="left"><font color="#555555">varchar(255) NN</font></td></tr><tr><td align="left" port="credits">credits</td><td align="left"><font color="#555555">tinyint(4) NN</font></td></tr><tr><td align="left" port="clo_target_pct">clo_target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">timestamp NN</font></td></tr></table>>];
"course_outlines" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EAF6EA" colspan="2"><b>course_outlines</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="course_id">course_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="chapter_number">chapter_number</td><td align="left"><font color="#555555">tinyint(4) NN</font></td></tr><tr><td align="left" port="chapter_name">chapter_name</td><td align="left"><font color="#555555">varchar(255) NN</font></td></tr></table>>];
"bloom_levels" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EAF6EA" colspan="2"><b>bloom_levels</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">tinyint(4) NN</font></td></tr><tr><td align="left" port="code">code</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="name_vi">name_vi</td><td align="left"><font color="#555555">varchar(50) NN</font></td></tr></table>>];
"clos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EAF6EA" colspan="2"><b>clos</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="course_id">course_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="clo_code">clo_code</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="bloom_level_id">bloom_level_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">tinyint(4)</font></td></tr></table>>];
"clo_plo_mapping" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EAF6EA" colspan="2"><b>clo_plo_mapping</b></td></tr><tr><td align="left" port="clo_id"><u>clo_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="plo_id"><u>plo_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="level">level</td><td align="left"><font color="#555555">char(1) NN</font></td></tr></table>>];
"plos@clo_plo_mapping" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>plos</b> <font point-size="8" color="#64748b">(B)</font></td></tr></table>>];
"clos" -> "clo_plo_mapping" [id="fk__clos__clo_plo_mapping__clo_id"];
"plos@clo_plo_mapping" -> "clo_plo_mapping" [id="fk__plos@clo_plo_mapping__clo_plo_mapping__plo_id"];
