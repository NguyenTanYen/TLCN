@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam dpi 160
skinparam shadowing false
skinparam ActivityBackgroundColor #EAF2FB
skinparam ActivityBorderColor #445566
skinparam ActivityDiamondBackgroundColor #FFF4D6
skinparam SwimlaneTitleFontStyle bold
|Giảng viên|
start
:Chọn môn học, nhập câu hỏi,\nchương, mức Bloom, các phương án;
:Gắn một/nhiều CLO kèm trọng số;
|Hệ thống|
if (Đúng 1 đáp án, 2–10 phương án,\nΣ trọng số CLO = 1?) then (không)
  :Trả lỗi 422, giữ dữ liệu đã nhập;
  |Giảng viên|
  :Sửa lại câu hỏi;
  detach
else (có)
  :Lưu question_bank, question_options,\nquestion_clo_mapping (1 giao dịch);
endif
|Giảng viên|
:Tạo bài KT cho lớp HP: chọn câu theo CLO/chương,\nđặt điểm, chọn loại minh chứng (quá trình/cuối kỳ);
|Hệ thống|
:Lưu exams, exam_questions (trạng thái Draft);
if (Hình thức?) then (trực tuyến)
  :Sinh Moodle XML\n(idnumber = QB-{id}, answer theo position);
  :Gọi Web Service local_clo_create_quiz;
  |Moodle LMS|
  :Nhập câu hỏi vào ngân hàng của khóa học,\ntạo Quiz bật xáo trộn phương án;
  |Hệ thống|
  :Lưu moodle_quiz_id (liên kết tự động);
  |Moodle LMS|
  :SV làm bài, Moodle tự chấm;
else (trên giấy)
  |Hệ thống|
  :Sinh Moodle XML; gọi Web Service\nlocal_clo_create_offlinequiz (số mã đề, xáo trộn);
  |Moodle LMS|
  :Offline Quiz: nhập câu hỏi, tạo N mã đề,\nsinh đề in, phiếu trả lời, đáp án (PDF/DOCX);
  |Hệ thống|
  :Lưu moodle_offlinequiz_id;\nchuyển tệp đề/phiếu cho GV tải (.zip);
  |Giảng viên|
  :In đề & phiếu, tổ chức thi;\nquét phiếu, tải ảnh lên Moodle;
  |Moodle LMS|
  :Nhận diện MSSV, mã đề, ô đánh dấu;\nchấm điểm (offlinequiz_results);
endif
|Hệ thống|
:Trạng thái bài KT = Published;
stop
@enduml
