@startuml
!include ucstyle.iuml
left to right direction
actor "Giảng viên" as GV
actor "Sinh viên" as SV
actor "Bộ môn /\nQuản trị CTĐT" as BM
actor "Moodle LMS\n<<hệ thống ngoài>>" as MD
rectangle "Hệ thống hỗ trợ kiểm tra, đánh giá và phân tích mức độ đạt CĐR" {
  usecase "UC-00\nĐăng nhập & phân quyền" as U0
  usecase "UC-01\nQuản lý ngân hàng câu hỏi\n(gắn chương, Bloom, CLO có trọng số)" as U1
  usecase "UC-02\nKhởi tạo bài kiểm tra\n(Moodle XML / nhiều mã đề)" as U2
  usecase "UC-03\nĐồng bộ bài làm từ Moodle" as U3
  usecase "UC-03b\nNhập phiếu trả lời bài giấy" as U3b
  usecase "UC-04\nThống kê lớp & đo CĐR môn học\n(p, DI, BM6a–6d)" as U4
  usecase "UC-05\nXem kết quả CLO &\nlộ trình ôn tập cá nhân" as U5
  usecase "UC-06\nQuản lý CTĐT, PLO/PI\n& kế hoạch đo (BM2, BM3b)" as U6
  usecase "UC-07\nBáo cáo đo lường CĐR CTĐT\n(BM3c, BM2)" as U7
}
GV --> U1
GV --> U2
GV --> U3
GV --> U3b
GV --> U4
SV --> U5
BM --> U6
BM --> U7
U3 --> MD : đọc CSDL\n(chỉ đọc)
U1 ..> U0 : <<include>>
U5 ..> U0 : <<include>>
U6 ..> U0 : <<include>>
@enduml
