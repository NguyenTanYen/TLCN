digraph G { rankdir=LR; graph [fontname="DejaVu Sans", splines=ortho, nodesep=0.6, ranksep=0.9 ];
node [shape=none, margin=0, fontname="DejaVu Sans", fontsize=10]; edge [color="#334155", penwidth=1.2, dir=none];
"exams" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE9E7" colspan="2"><b>exams</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="class_section_id">class_section_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11) NN</font></td></tr><tr><td align="left" port="exam_title">exam_title</td><td align="left"><font color="#555555">varchar(255) NN</font></td></tr><tr><td align="left" port="assessment_type">assessment_type</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="exam_type">exam_type</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="exam_date">exam_date</td><td align="left"><font color="#555555">date</font></td></tr><tr><td align="left" port="duration_minutes">duration_minutes</td><td align="left"><font color="#555555">smallint(6)</font></td></tr><tr><td align="left" port="max_score">max_score</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr><tr><td align="left" port="moodle_quiz_id">moodle_quiz_id</td><td align="left"><font color="#555555">bigint(20)</font></td></tr><tr><td align="left" port="moodle_offlinequiz_id">moodle_offlinequiz_id</td><td align="left"><font color="#555555">bigint(20)</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="publish_flag">publish_flag</td><td align="left"><font color="#555555">tinyint(1) NN</font></td></tr><tr><td align="left" port="last_synced_at">last_synced_at</td><td align="left"><font color="#555555">datetime</font></td></tr><tr><td align="left" port="created_by">created_by <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int(11)</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">timestamp NN</font></td></tr></table>>];
