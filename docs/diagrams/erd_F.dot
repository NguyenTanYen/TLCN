digraph G { rankdir=LR; graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.7, dpi=160 ];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [color="#555555", arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.7];
"exams" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE9E7" colspan="2"><b>exams</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="class_section_id">class_section_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="exam_title">exam_title</td><td align="left"><font color="#555555">varchar(255) NN</font></td></tr><tr><td align="left" port="assessment_type">assessment_type</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="exam_type">exam_type</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="exam_date">exam_date</td><td align="left"><font color="#555555">date</font></td></tr><tr><td align="left" port="duration_minutes">duration_minutes</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="max_score">max_score</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr><tr><td align="left" port="moodle_quiz_id">moodle_quiz_id</td><td align="left"><font color="#555555">bigint</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="publish_flag">publish_flag</td><td align="left"><font color="#555555">tinyint(1) NN</font></td></tr><tr><td align="left" port="last_synced_at">last_synced_at</td><td align="left"><font color="#555555">datetime</font></td></tr><tr><td align="left" port="created_by">created_by <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">timestamp NN</font></td></tr></table>>];
"exam_questions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE9E7" colspan="2"><b>exam_questions</b></td></tr><tr><td align="left" port="exam_id"><u>exam_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="question_id"><u>question_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="order_index">order_index</td><td align="left"><font color="#555555">smallint NN</font></td></tr><tr><td align="left" port="points">points</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr></table>>];
"exam_versions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE9E7" colspan="2"><b>exam_versions</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="exam_id">exam_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="version_code">version_code</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr></table>>];
"exam_version_questions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE9E7" colspan="2"><b>exam_version_questions</b></td></tr><tr><td align="left" port="version_id"><u>version_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="question_id"><u>question_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="position">position</td><td align="left"><font color="#555555">smallint NN</font></td></tr></table>>];
"exam_version_options" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FDE9E7" colspan="2"><b>exam_version_options</b></td></tr><tr><td align="left" port="version_id"><u>version_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="question_id"><u>question_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="displayed_label"><u>displayed_label</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">char(1) NN</font></td></tr><tr><td align="left" port="option_id">option_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr></table>>];
"class_sections" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>class_sections</b></td></tr></table>>];
"question_bank" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>question_bank</b></td></tr></table>>];
"question_options" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>question_options</b></td></tr></table>>];
"users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>users</b></td></tr></table>>];
"exams":"id" -> "exam_questions":"exam_id" [arrowtail=tee];
"question_bank" -> "exam_questions" [arrowtail=tee];
"exam_version_questions":"version_id" -> "exam_version_options":"version_id" [arrowtail=tee];
"exam_version_questions":"question_id" -> "exam_version_options":"question_id" [arrowtail=tee];
"question_options" -> "exam_version_options" [arrowtail=tee];
"question_bank" -> "exam_version_questions" [arrowtail=tee];
"exam_versions":"id" -> "exam_version_questions":"version_id" [arrowtail=tee];
"exams":"id" -> "exam_versions":"exam_id" [arrowtail=tee];
"users" -> "exams" [arrowtail=tee];
"class_sections" -> "exams" [arrowtail=tee];
}