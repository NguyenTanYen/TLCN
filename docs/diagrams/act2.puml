@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam dpi 160
skinparam shadowing false
skinparam ActivityBackgroundColor #EAF2FB
skinparam ActivityBorderColor #445566
skinparam ActivityDiamondBackgroundColor #FFF4D6
|Giảng viên|
start
if (Hình thức?) then (trực tuyến)
  :Nhấn "Đồng bộ & phân tích";
  |Hệ thống|
  :sp_sync_exam: đọc lượt bài được tính điểm\n(theo grademethod, bỏ lượt xem trước);
  if (Quiz tồn tại & mọi câu ánh xạ được QB-n?) then (không)
    :ROLLBACK, ghi sync_runs = failed,\nbáo lỗi cho GV;
    stop
  endif
  :Reverse Shuffle: _order + answer\n→ phương án gốc;
else (trên giấy)
  |Giảng viên|
  :Nhấn "Đồng bộ & phân tích";
  |Hệ thống|
  :Web Service local_clo_process_scans:\nMoodle chấm ngay các phiếu còn chờ;
  if (Moodle đã chấm được phiếu nào?) then (chưa)
    :Báo "Moodle chưa chấm phiếu nào";
    stop
  endif
  :sp_sync_exam: đọc offlinequiz_results đã chấm\n(kết quả mới nhất, mã đề A/B/C…);
  :Reverse Shuffle theo _order của mã đề\n→ phương án gốc;
endif
:Ghi exam_attempts, item_level_results\n(answered / blank / absent);
:Analysis Engine (Pandas): p, DI (Kelley 27%),\nđiểm CLO từng SV (BM6c);
:Tổng hợp CLO lớp HP (BM6b/6d) → PI (BM3c) → PLO (BM2);
:Sinh lộ trình ôn tập cho SV chưa đạt CLO;
|Giảng viên|
:Xem phổ điểm, chỉ số câu hỏi, kết quả CLO,\nminh chứng; ghi nhận xét & cải tiến;
fork
  :Xuất BM6 (.xlsx);
fork again
  :Công bố kết quả lên Moodle;
  |Hệ thống|
  :Gửi kết quả từng SV qua\nWeb Service local_clo_push_results;
  |Moodle LMS|
  :Lưu kết quả, gửi thông báo;
  |Sinh viên|
  :Trên Moodle: xem radar CLO so với\nngưỡng & TB lớp, lộ trình ôn tập;
fork again
  |Bộ môn|
  :Xem tổng hợp PLO năm học,\nnhập nhận xét, xuất BM2/BM3;
end fork
stop
@enduml
