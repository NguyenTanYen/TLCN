digraph G { rankdir=LR; graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.7, dpi=160 ];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [color="#555555", arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.7];
"clo_assessment_plans" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F3ECFA" colspan="2"><b>clo_assessment_plans</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="clo_id">clo_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="semester_id">semester_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="assessments_text">assessments_text</td><td align="left"><font color="#555555">varchar(255)</font></td></tr><tr><td align="left" port="evidence_type">evidence_type</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="method">method</td><td align="left"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="cycle">cycle</td><td align="left"><font color="#555555">varchar(30) NN</font></td></tr><tr><td align="left" port="pass_threshold_pct">pass_threshold_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr><tr><td align="left" port="target_pct">target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr></table>>];
"pi_assessment_plans" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F3ECFA" colspan="2"><b>pi_assessment_plans</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="pi_id">pi_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="course_id">course_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="semester_id">semester_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="method">method</td><td align="left"><font color="#555555">varchar(150) NN</font></td></tr><tr><td align="left" port="cycle">cycle</td><td align="left"><font color="#555555">varchar(30) NN</font></td></tr><tr><td align="left" port="target_pct">target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr><tr><td align="left" port="lecturer_id">lecturer_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int</font></td></tr></table>>];
"pi_plan_clos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F3ECFA" colspan="2"><b>pi_plan_clos</b></td></tr><tr><td align="left" port="plan_id"><u>plan_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="clo_id"><u>clo_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr></table>>];
"assessment_assignments" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F3ECFA" colspan="2"><b>assessment_assignments</b></td></tr><tr><td align="left" port="semester_id"><u>semester_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="course_id"><u>course_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="lecturer_id"><u>lecturer_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="note">note</td><td align="left"><font color="#555555">varchar(255)</font></td></tr></table>>];
"clos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>clos</b></td></tr></table>>];
"courses" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>courses</b></td></tr></table>>];
"lecturers" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>lecturers</b></td></tr></table>>];
"performance_indicators" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>performance_indicators</b></td></tr></table>>];
"semesters" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>semesters</b></td></tr></table>>];
"courses" -> "assessment_assignments" [arrowtail=tee];
"lecturers" -> "assessment_assignments" [arrowtail=tee];
"semesters" -> "assessment_assignments" [arrowtail=tee];
"clos" -> "clo_assessment_plans" [arrowtail=tee];
"semesters" -> "clo_assessment_plans" [arrowtail=tee];
"courses" -> "pi_assessment_plans" [arrowtail=tee];
"lecturers" -> "pi_assessment_plans" [arrowtail=tee];
"performance_indicators" -> "pi_assessment_plans" [arrowtail=tee];
"semesters" -> "pi_assessment_plans" [arrowtail=tee];
"clos" -> "pi_plan_clos" [arrowtail=tee];
"pi_assessment_plans":"id" -> "pi_plan_clos":"plan_id" [arrowtail=tee];
}