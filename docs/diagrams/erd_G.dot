digraph G { rankdir=LR; graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.7, dpi=160 ];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [color="#555555", arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.7];
"exam_attempts" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E6F4F4" colspan="2"><b>exam_attempts</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="exam_id">exam_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="student_id">student_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="version_id">version_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="moodle_attempt_id">moodle_attempt_id</td><td align="left"><font color="#555555">bigint</font></td></tr><tr><td align="left" port="source">source</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="started_at">started_at</td><td align="left"><font color="#555555">datetime</font></td></tr><tr><td align="left" port="finished_at">finished_at</td><td align="left"><font color="#555555">datetime</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="total_score">total_score</td><td align="left"><font color="#555555">decimal(6,2) NN</font></td></tr></table>>];
