digraph G { rankdir=LR; graph [fontname="DejaVu Sans", splines=ortho, nodesep=0.6, ranksep=0.9 ];
node [shape=none, margin=0, fontname="DejaVu Sans", fontsize=10]; edge [color="#334155", penwidth=1.2, dir=none];
"programs" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>programs</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="code">code</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">varchar(255) NN</font></td></tr><tr><td align="left" port="level">level</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="department">department</td><td align="left"><font color="#555555">varchar(150)</font></td></tr><tr><td align="left" port="target_pct">target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr><tr><td align="left" port="name_en">name_en</td><td align="left"><font color="#555555">varchar(255)</font></td></tr><tr><td align="left" port="faculty">faculty</td><td align="left"><font color="#555555">varchar(150)</font></td></tr><tr><td align="left" port="major_code">major_code</td><td align="left"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="cohort_year">cohort_year</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="total_credits">total_credits</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left" port="decision_no">decision_no</td><td align="left"><font color="#555555">varchar(100)</font></td></tr><tr><td align="left" port="objective">objective</td><td align="left"><font color="#555555">text</font></td></tr></table>>];
"plos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>plos</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="program_id">program_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="group_no">group_no</td><td align="left"><font color="#555555">tinyint NN</font></td></tr><tr><td align="left" port="plo_code">plo_code</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="target_pct">target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr><tr><td align="left" port="competency_level">competency_level</td><td align="left"><font color="#555555">tinyint</font></td></tr><tr><td align="left" port="plo_type">plo_type</td><td align="left"><font color="#555555">varchar(30)</font></td></tr></table>>];
