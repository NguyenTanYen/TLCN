digraph G { rankdir=LR; graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.7, dpi=160 ];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [color="#555555", arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.7];
"programs" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>programs</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="code">code</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">varchar(255) NN</font></td></tr><tr><td align="left" port="level">level</td><td align="left"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="department">department</td><td align="left"><font color="#555555">varchar(150)</font></td></tr><tr><td align="left" port="target_pct">target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr></table>>];
"plos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>plos</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="program_id">program_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="group_no">group_no</td><td align="left"><font color="#555555">tinyint NN</font></td></tr><tr><td align="left" port="plo_code">plo_code</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="target_pct">target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr></table>>];
"plo_measurement_plans" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>plo_measurement_plans</b></td></tr><tr><td align="left" port="plo_id"><u>plo_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="round_no"><u>round_no</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">tinyint NN</font></td></tr><tr><td align="left" port="academic_year">academic_year</td><td align="left"><font color="#555555">varchar(9) NN</font></td></tr><tr><td align="left" port="target_pct">target_pct</td><td align="left"><font color="#555555">decimal(5,2) NN</font></td></tr></table>>];
"performance_indicators" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>performance_indicators</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="plo_id">plo_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="pi_code">pi_code</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">text NN</font></td></tr></table>>];
"program_courses" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>program_courses</b></td></tr><tr><td align="left" port="program_id"><u>program_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="course_id"><u>course_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr></table>>];
"pi_courses" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>pi_courses</b></td></tr><tr><td align="left" port="pi_id"><u>pi_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="course_id"><u>course_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr></table>>];
"courses" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>courses</b></td></tr></table>>];
"plos":"id" -> "performance_indicators":"plo_id" [arrowtail=tee];
"courses" -> "pi_courses" [arrowtail=tee];
"performance_indicators":"id" -> "pi_courses":"pi_id" [arrowtail=tee];
"plos":"id" -> "plo_measurement_plans":"plo_id" [arrowtail=tee];
"programs":"id" -> "plos":"program_id" [arrowtail=tee];
"courses" -> "program_courses" [arrowtail=tee];
"programs":"id" -> "program_courses":"program_id" [arrowtail=tee];
}