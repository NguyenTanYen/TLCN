"performance_indicators" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#E8F1FB" colspan="2"><b>performance_indicators</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="plo_id">plo_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="pi_code">pi_code</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="competency_level">competency_level</td><td align="left"><font color="#555555">tinyint</font></td></tr></table>>];
