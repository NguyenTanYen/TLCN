@startuml
!include ../sdstyle.iuml
actor "Giảng viên" as GV
boundary "ExamDetail\n(PaperFlow)" as UI
control "paper_exam router" as R
participant "OMR\n(omr.py)" as O
database "assessment_db" as DB
control "Analysis Engine" as AE
GV -> UI : chọn ảnh/PDF phiếu; "Chấm phiếu"
UI -> R : POST /api/exams/{id}/scan/save
R -> DB : bài giấy? đã có mã đề? không dùng Offline Quiz?
loop mỗi trang phiếu
  R -> O : load_pages; read_sheet(ảnh)
  O --> R : {MSSV, mã đề, đáp án từng câu,\nđộ tin cậy, cảnh báo}
  R -> DB : INSERT scan_sheets;\nđối chiếu danh sách lớp và các mã đề
  alt MSSV và mã đề hợp lệ
    R -> DB : chấm theo đáp án của mã đề →\nexam_attempts, item_level_results; status = saved
  else có vấn đề
    R -> DB : status = review (kèm cảnh báo)
  end
end
R --> UI : {saved, review, errors, sheets}
loop mỗi phiếu cần soát
  GV -> UI : xem ảnh phiếu tô màu; sửa MSSV, mã đề hoặc đáp án
  UI -> R : PATCH /api/exams/{id}/scan/sheets/{sheet_id}
  R -> DB : chấm lại; status = saved
  R --> UI : {status, issues}
end
GV -> UI : "Hoàn tất chấm" (đánh dấu vắng, phân tích)
UI -> R : POST /api/exams/{id}/scan/finish
R -> DB : SV không có phiếu → absent; sync_runs;\nstatus = Synced
R -> AE : analyze_exam(id)
AE -> DB : kết quả phân tích; status = Analyzed
R --> UI : {saved, review, absent, analysis}
note over GV, R : Phiếu nộp lại cho cùng một MSSV thay thế phiếu cũ\n(phiếu cũ chuyển trạng thái superseded).
@enduml
