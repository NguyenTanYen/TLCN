@startuml
!include ../actstyle.iuml
|Giảng viên|
start
:Thu phiếu, quét hoặc chụp ảnh\n(ảnh hoặc PDF nhiều trang);
:Trang bài KT → "Chấm phiếu";\ntải ảnh/PDF lên hệ thống;
|Hệ thống|
if (Chưa sinh mã đề\nhoặc bài dùng Offline Quiz?) then (có)
  :409;
  stop
endif
repeat
  :OMR: nắn phẳng ảnh theo 4 ô định vị;\nđọc MSSV, mã đề, ô tô từng câu;
  :Lưu scan_sheets; đối chiếu danh sách lớp\nvà các mã đề của bài;
  if (MSSV và mã đề hợp lệ?) then (có)
    :Chấm theo đáp án của mã đề;\nghi exam_attempts, item_level_results;\nphiếu ở trạng thái saved;
  else (không)
    :Phiếu ở trạng thái review\nkèm cảnh báo;
    |Giảng viên|
    :Xem ảnh phiếu tô màu các ô đọc được;\nsửa MSSV, mã đề hoặc đáp án; lưu;
    |Hệ thống|
    :Chấm lại; phiếu → saved;
  endif
repeat while (Còn phiếu?) is (còn)
|Giảng viên|
:"Hoàn tất chấm": đánh dấu SV\nkhông có phiếu là vắng; chọn phân tích;
|Hệ thống|
:Ghi sync_runs; bài KT → Synced;\nphân tích → Analyzed;
|Giảng viên|
:Xem số phiếu đã chấm, số vắng,\nkết quả phân tích;
stop
@enduml
