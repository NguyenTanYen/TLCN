@startuml
!include ../actstyle.iuml
|Giảng viên|
start
:Lớp HP → "Tạo bài KT";\nhình thức trên giấy;
:Nhập số câu, phạm vi chương\n(kiểm tra chương), phân bố mức Bloom\nhoặc ma trận chương × Bloom;
repeat
  |Hệ thống|
  :Lập ma trận đề; chọn câu từng ô\nphủ đủ CLO, tránh câu DI âm/thấp;
  if (Ô / CLO / mức thiếu câu?) then (có)
    :Báo cụ thể: ô nào cần bao nhiêu,\nngân hàng có bao nhiêu;
    |Giảng viên|
    :Chỉnh số câu / ma trận / phạm vi\nhoặc bổ sung câu hỏi;
  else (không)
    |Giảng viên|
  endif
repeat while (Sinh lại?) is (có)
:Xem ma trận, độ phủ CLO;\nchỉnh tay: bỏ/thêm câu, đổi điểm;
|Hệ thống|
if (Câu khác môn, đã Hủy\nhoặc chưa gán CLO?) then (có)
  :422 – nêu câu lỗi;
  stop
endif
:Lưu bài KT (Draft);
|Giảng viên|
:Chọn số mã đề (1–8), xáo câu/phương án;\n"Sinh mã đề";
|Hệ thống|
if (Bài đã có kết quả chấm, có câu không\nphải trắc nghiệm, hoặc câu ngoài 2–6 phương án?) then (có)
  :409 – nêu lý do;
  stop
endif
:Sinh mã đề 01, 02, …: lưu exam_versions,\nexam_version_questions, exam_version_options;\nđáp án theo từng mã đề; bài KT → Published;
|Giảng viên|
:Xem trước từng mã đề (trang A4, 1 hoặc 2 cột);\nsửa câu, chỉnh phiếu trả lời (số chữ số MSSV, mã đề);
|Hệ thống|
:Xuất đề PDF/Word, phiếu trả lời,\nđáp án, gói .zip;
|Giảng viên|
:In đề và phiếu; tổ chức thi;
stop
@enduml
