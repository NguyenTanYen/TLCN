digraph G { rankdir=LR; graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.7, dpi=160 ];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [color="#555555", arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.7];
"class_sections" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FFF7D6" colspan="2"><b>class_sections</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="course_id">course_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="semester_id">semester_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="lecturer_id">lecturer_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="section_code">section_code</td><td align="left"><font color="#555555">varchar(30) NN</font></td></tr><tr><td align="left" port="moodle_course_id">moodle_course_id</td><td align="left"><font color="#555555">bigint</font></td></tr></table>>];
"enrollments" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FFF7D6" colspan="2"><b>enrollments</b></td></tr><tr><td align="left" port="class_section_id"><u>class_section_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="student_id"><u>student_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(10) NN</font></td></tr><tr><td align="left" port="enrolled_at">enrolled_at</td><td align="left"><font color="#555555">timestamp NN</font></td></tr></table>>];
"question_bank" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FFF7D6" colspan="2"><b>question_bank</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="course_id">course_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="outline_id">outline_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="bloom_level_id">bloom_level_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">tinyint NN</font></td></tr><tr><td align="left" port="question_type">question_type</td><td align="left"><font color="#555555">varchar(30) NN</font></td></tr><tr><td align="left" port="content">content</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="moodle_question_id">moodle_question_id</td><td align="left"><font color="#555555">bigint</font></td></tr><tr><td align="left" port="is_cancelled">is_cancelled</td><td align="left"><font color="#555555">tinyint(1) NN</font></td></tr><tr><td align="left" port="cancel_reason">cancel_reason</td><td align="left"><font color="#555555">varchar(255)</font></td></tr><tr><td align="left" port="created_by">created_by <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">timestamp NN</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#555555">timestamp NN</font></td></tr></table>>];
"question_options" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FFF7D6" colspan="2"><b>question_options</b></td></tr><tr><td align="left" port="id"><u>id</u> <font color="#1d4ed8" point-size="8">PK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="question_id">question_id <font color="#1d4ed8" point-size="8">FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="position">position</td><td align="left"><font color="#555555">tinyint NN</font></td></tr><tr><td align="left" port="opt_label">opt_label</td><td align="left"><font color="#555555">char(1) NN</font></td></tr><tr><td align="left" port="content">content</td><td align="left"><font color="#555555">text NN</font></td></tr><tr><td align="left" port="is_correct">is_correct</td><td align="left"><font color="#555555">tinyint(1) NN</font></td></tr><tr><td align="left" port="moodle_answer_id">moodle_answer_id</td><td align="left"><font color="#555555">bigint</font></td></tr><tr><td align="left" port="correct_key">correct_key</td><td align="left"><font color="#555555">int</font></td></tr></table>>];
"question_clo_mapping" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#FFF7D6" colspan="2"><b>question_clo_mapping</b></td></tr><tr><td align="left" port="question_id"><u>question_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="clo_id"><u>clo_id</u> <font color="#1d4ed8" point-size="8">PK FK</font></td><td align="left"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="weight">weight</td><td align="left"><font color="#555555">decimal(3,2) NN</font></td></tr></table>>];
"bloom_levels" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>bloom_levels</b></td></tr></table>>];
"clos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>clos</b></td></tr></table>>];
"course_outlines" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>course_outlines</b></td></tr></table>>];
"courses" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>courses</b></td></tr></table>>];
"lecturers" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>lecturers</b></td></tr></table>>];
"semesters" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>semesters</b></td></tr></table>>];
"students" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>students</b></td></tr></table>>];
"users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#EEEEEE" colspan="2"><b>users</b></td></tr></table>>];
"courses" -> "class_sections" [arrowtail=tee];
"lecturers" -> "class_sections" [arrowtail=tee];
"semesters" -> "class_sections" [arrowtail=tee];
"class_sections":"id" -> "enrollments":"class_section_id" [arrowtail=tee];
"students" -> "enrollments" [arrowtail=tee];
"bloom_levels" -> "question_bank" [arrowtail=tee];
"courses" -> "question_bank" [arrowtail=tee];
"users" -> "question_bank" [arrowtail=tee];
"course_outlines" -> "question_bank" [arrowtail=tee];
"clos" -> "question_clo_mapping" [arrowtail=tee];
"question_bank":"id" -> "question_clo_mapping":"question_id" [arrowtail=tee];
"question_bank":"id" -> "question_options":"question_id" [arrowtail=tee];
}